# =============================================================================
# SiteGen AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME=SiteGen AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/sitegen_ai

# --- JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenRouter AI ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/sitegen.log
