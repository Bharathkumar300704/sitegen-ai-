"""
Gemini API client — uses the REST API directly via httpx.

WHY REST INSTEAD OF THE PYTHON SDK:
  The google-generativeai Python SDK uses gRPC transport and expects
  keys in the AIza* format.  Keys prefixed with AQ. are Google AI Studio
  short-lived credentials that only work via the v1beta REST endpoint
  (the same endpoint that GET /v1beta/models?key=... uses successfully).
  Using httpx with ?key= query-param makes both key formats work.
"""

import time
import httpx
from functools import lru_cache
from config.logging_config import get_logger

logger = get_logger(__name__)

# ── Constants ────────────────────────────────────────────────────────────────
GEMINI_REST_BASE = "https://generativelanguage.googleapis.com/v1beta"
MODEL_NAME       = "gemini-2.0-flash"
GENERATE_URL     = f"{GEMINI_REST_BASE}/models/{MODEL_NAME}:generateContent"

# ── Load API key fresh (bypass lru_cache on settings so env changes apply) ──
def _load_api_key() -> str:
    """Read the API key directly from the environment / .env file."""
    import os
    from dotenv import load_dotenv          # already installed via python-dotenv
    load_dotenv(override=True)              # re-read .env on every call (cheap)
    key = os.environ.get("GEMINI_API_KEY", "").strip()
    return key


def _get_api_key() -> str:
    key = _load_api_key()
    if not key:
        raise RuntimeError(
            "GEMINI_API_KEY is not set. "
            "Add it to your .env file and restart the server."
        )
    return key


# ── Core REST caller ─────────────────────────────────────────────────────────
def _call_gemini_rest(prompt: str, system_instruction: str = None) -> str:
    """
    POST to the Gemini generateContent REST endpoint.
    Returns the text string on success, raises RuntimeError on failure.
    Logs the full request and response for debugging.
    """
    api_key = _get_api_key()

    # Build request body
    body: dict = {
        "contents": [
            {
                "role": "user",
                "parts": [{"text": prompt}]
            }
        ],
        "generationConfig": {
            "temperature": 0.7,
            "maxOutputTokens": 8192,
        }
    }
    if system_instruction:
        body["systemInstruction"] = {
            "parts": [{"text": system_instruction}]
        }

    url    = f"{GENERATE_URL}?key={api_key}"
    log_url = f"{GENERATE_URL}?key={api_key[:8]}...{api_key[-4:]}"

    # ── PRE-REQUEST DIAGNOSTIC LOG ────────────────────────────────────────────
    logger.info("═" * 70)
    logger.info("GEMINI REST REQUEST")
    logger.info(f"  URL         : {log_url}")
    logger.info(f"  Model       : {MODEL_NAME}")
    logger.info(f"  API Key     : {api_key[:8]}...{api_key[-4:] if len(api_key) > 12 else '****'}")
    logger.info(f"  Key length  : {len(api_key)}")
    logger.info(f"  Prompt len  : {len(prompt)} chars")
    logger.info(f"  Prompt head : {prompt[:300]!r}")
    if system_instruction:
        logger.info(f"  SysInstruct : {system_instruction[:100]!r}")
    logger.info("═" * 70)

    try:
        with httpx.Client(timeout=120.0) as client:
            response = client.post(
                url,
                json=body,
                headers={"Content-Type": "application/json"},
            )

        # ── POST-REQUEST DIAGNOSTIC LOG ───────────────────────────────────────
        logger.info("─" * 70)
        logger.info("GEMINI REST RESPONSE")
        logger.info(f"  HTTP Status : {response.status_code}")
        logger.info(f"  Headers     : {dict(response.headers)}")

        raw = response.text
        logger.info(f"  Raw len     : {len(raw)} chars")
        logger.info(f"  Raw head    : {raw[:500]!r}")
        logger.info("─" * 70)

        if response.status_code != 200:
            # Surface the exact Google error — never hide it
            _handle_http_error(response.status_code, raw)

        # Parse the successful response
        data = response.json()
        logger.info(f"  Parsed JSON keys: {list(data.keys())}")

        try:
            text = data["candidates"][0]["content"]["parts"][0]["text"]
        except (KeyError, IndexError) as parse_err:
            logger.error(f"Unexpected response structure: {data}")
            raise RuntimeError(
                f"Gemini response parsing failed: {parse_err}\n"
                f"Full response: {raw[:1000]}"
            )

        logger.info(f"  Extracted text len: {len(text)}")
        logger.info(f"  Text head: {text[:300]!r}")
        return text

    except httpx.TimeoutException as e:
        logger.error(f"Gemini request TIMED OUT after 120s: {e}")
        raise RuntimeError(f"Gemini request timed out: {e}")

    except httpx.RequestError as e:
        logger.error(f"Gemini network error: {type(e).__name__}: {e}")
        raise RuntimeError(f"Gemini network error: {e}")


def _handle_http_error(status: int, raw: str):
    """Parse and raise a human-readable error from a non-200 HTTP response."""
    import json as _json
    try:
        err_data = _json.loads(raw)
        msg = err_data.get("error", {}).get("message", raw[:500])
        code = err_data.get("error", {}).get("code", status)
        status_str = err_data.get("error", {}).get("status", "")
    except Exception:
        msg = raw[:500]
        code = status
        status_str = ""

    full_msg = f"[HTTP {code}] {status_str}: {msg}"
    logger.error(f"Gemini API error: {full_msg}")

    if status == 400:
        raise RuntimeError(f"BAD_REQUEST: {full_msg}")
    elif status == 401:
        raise RuntimeError(
            f"UNAUTHORIZED — API key is invalid or missing. "
            f"Go to https://aistudio.google.com/app/apikey and create a new key. "
            f"Detail: {full_msg}"
        )
    elif status == 403:
        raise RuntimeError(
            f"FORBIDDEN — API key doesn't have permission for this operation. "
            f"Ensure the Generative Language API is enabled for your project. "
            f"Detail: {full_msg}"
        )
    elif status == 404:
        raise RuntimeError(
            f"NOT_FOUND — endpoint or model not found. "
            f"Model used: {MODEL_NAME}. Detail: {full_msg}"
        )
    elif status == 429:
        raise RuntimeError(
            f"QUOTA_EXCEEDED — too many requests or quota exhausted. "
            f"Detail: {full_msg}"
        )
    elif status == 500:
        raise RuntimeError(f"GEMINI_SERVER_ERROR: {full_msg}")
    else:
        raise RuntimeError(f"GEMINI_ERROR_{status}: {full_msg}")


# ── Public interface ─────────────────────────────────────────────────────────
def generate_content(prompt: str, system_instruction: str = None,
                     max_retries: int = 2) -> str:
    """
    Generate content via the Gemini REST API with retry logic.
    - 429 QUOTA_EXCEEDED → fail immediately (no retry)
    - Other transient errors → retry up to max_retries with back-off
    Returns the generated text string, or raises RuntimeError.
    """
    for attempt in range(max_retries):
        try:
            return _call_gemini_rest(prompt, system_instruction)

        except RuntimeError as e:
            err_str = str(e)
            logger.error(f"generate_content attempt {attempt + 1}/{max_retries} FAILED: {err_str[:300]}")

            # Quota / auth errors → don't retry, propagate immediately
            if any(tag in err_str for tag in [
                "QUOTA_EXCEEDED", "UNAUTHORIZED", "FORBIDDEN",
                "BAD_REQUEST", "NOT_FOUND"
            ]):
                raise

            if attempt < max_retries - 1:
                wait = 2 ** attempt
                logger.info(f"Retrying in {wait}s ...")
                time.sleep(wait)
            else:
                logger.error(f"Gemini failed after {max_retries} attempts.")
                raise


def check_api_key_status() -> dict:
    """
    Lightweight health-check: sends a minimal generateContent request.
    Returns {"ok": bool, "error": str|None, "quota_exhausted": bool, ...}
    """
    try:
        key = _get_api_key()
    except RuntimeError as e:
        return {"ok": False, "error": str(e), "quota_exhausted": False}

    # Try the lightest possible call
    try:
        text = _call_gemini_rest("Reply with exactly one word: OK")
        return {
            "ok": True,
            "error": None,
            "quota_exhausted": False,
            "response": text.strip(),
            "key_prefix": key[:8] + "...",
            "model": MODEL_NAME,
            "endpoint": GENERATE_URL,
        }
    except RuntimeError as e:
        err = str(e)
        is_quota = "QUOTA_EXCEEDED" in err or "429" in err or "quota" in err.lower()
        return {
            "ok": False,
            "error": err,
            "quota_exhausted": is_quota,
            "key_prefix": key[:8] + "...",
            "model": MODEL_NAME,
            "endpoint": GENERATE_URL,
        }
